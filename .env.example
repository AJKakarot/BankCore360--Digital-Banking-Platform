# BankCore 360 - Environment Variables Configuration Template
# Copy this file to .env or export these variables in your environment

# Server Port
PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bankcore360
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Full JDBC URL (optional override)
# DB_URL=jdbc:postgresql://localhost:5432/bankcore360

# Hibernate DDL Auto (none, validate, update, create, create-drop)
JPA_DDL_AUTO=update
SHOW_SQL=false

# HikariCP Pool Configuration
DB_CONNECTION_TIMEOUT=20000
DB_MAX_POOL_SIZE=10
DB_MIN_IDLE=2

# Local Development Security (HTTP Basic Test Users: dev_customer, dev_checker, dev_manager, dev_admin)
DEV_USER_PASSWORD=devPassword123!
